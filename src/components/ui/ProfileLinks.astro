---
import { themeConfig } from '@/config'
---

<div class="profile-links">
  <a href="/resume.pdf" class="profile-link" target="_blank" rel="noopener noreferrer">
    resume
  </a>
  <a href="https://linkedin.com/in/sddhrthrt" class="profile-link" target="_blank" rel="noopener noreferrer">
    linkedin
  </a>
</div>

<script
  is:inline
  define:vars={{
    contentWidth: themeConfig.general.contentWidth,
    centeredLayout: themeConfig.general.centeredLayout,
    toc: themeConfig.post.toc
  }}
>
  ;(function () {
    // Mirror of the back button: move the links into the right margin when there is room for them
    function adjustProfileLinksPosition() {
      const links = document.querySelector('.profile-links')
      if (!links) return

      if (!centeredLayout) {
        links.classList.remove('fixed-position')
        links.style.right = ''
        return
      }

      const pageWidth = window.innerWidth
      const contentWidthValue = parseFloat(contentWidth)
      const widthValue = Math.min(contentWidthValue, 50)
      const shouldUseCustomWidth = widthValue > 25
      const finalWidthValue = shouldUseCustomWidth ? widthValue : 25
      const margin = (pageWidth - finalWidthValue * 16) / 2
      const baseMinSpace = 11 * 16 // Same threshold as the back button
      const minSpace = toc ? baseMinSpace + 52 : baseMinSpace + 12
      const gap = 48 // Distance kept from the content edge, same as the back button
      const linksWidth = links.offsetWidth

      if (margin >= minSpace) {
        links.classList.add('fixed-position')
        links.style.right = `${margin - gap - linksWidth}px`
      } else {
        links.classList.remove('fixed-position')
        links.style.right = ''
      }
    }

    if (!window.__profileLinksBound) {
      window.__profileLinksBound = true
      document.addEventListener('astro:page-load', adjustProfileLinksPosition)
      window.addEventListener('resize', adjustProfileLinksPosition)
    }

    adjustProfileLinksPosition()
  })()
</script>

<style>
  .profile-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .profile-link {
    font-family: var(--serif);
    font-size: var(--font-size-m);
    font-style: italic;
    letter-spacing: 0;
    line-height: 1.75;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.2s ease-out;
    text-decoration: none;
  }

  .profile-link:hover {
    color: var(--text-primary);
  }

  @media (hover: none) and (pointer: coarse) {
    .profile-link:hover {
      color: var(--text-secondary);
    }
  }

  .profile-links.fixed-position {
    position: fixed;
    top: 6rem;
    z-index: 10;
  }
</style>
